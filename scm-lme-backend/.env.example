PGHOST=localhost
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=your_username
PGPASSWORD=your_password

# comma-separated list — the frontend must send one of these in the X-API-Key header
API_KEYS=change-me-to-a-long-random-value

# set only in production, matching the nginx location prefix (e.g. /scm)
# leave unset for local runs (docs/routes work at plain / then)
ROOT_PATH=
