# Unset everything below and the app runs exactly as it does today
# (local dev / current Render deploy) -- these only matter once the
# backend is deployed standalone on EC2, behind nginx, with the
# frontend hosted separately on S3/CloudFront.

# comma-separated list of frontend origins allowed to call this API
# cross-origin. Leave unset to disable CORS entirely (same-origin only).
CORS_ORIGINS=https://dsgvjfnd2ao8v.cloudfront.net

# set only in production, matching the nginx location prefix (e.g. /l0l1)
# leave unset for local runs (docs/routes work at plain / then)
ROOT_PATH=

# absolute base URL this backend is publicly reachable at, e.g.
# https://orion.algihaz.com/l0l1 -- prefixes /local-files/... links returned
# in API responses so they resolve correctly from a different-origin
# frontend. Leave unset when frontend and backend share an origin.
PUBLIC_BASE_URL=

# Postgres connection (required for a real deploy -- SQLite is the local
# dev default, and app.py uses Postgres-specific features: native enums,
# psycopg2). No migration tool -- backend.seed applies schema changes
# idempotently on every deploy, see docs/RUNBOOK.md.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set only when DATABASE_URL points at a database shared with other
# projects (e.g. Algihaz's UAT server, where scm/tender/incident/... each
# get their own schema in one shared database) -- scopes every table this
# app creates/reads/writes to this one Postgres schema, leaving every other
# schema in that database untouched. Leave unset for a dedicated database.
# DB_SCHEMA=l0l1

# GAHIZ AI support chat (deferred for now -- 503s gracefully if unset)
# ANTHROPIC_API_KEY=

# Per-client-IP request cap (see backend/main.py's RateLimitMiddleware).
# Default 300/minute if unset.
# RATE_LIMIT_PER_MINUTE=300

# STORAGE_BACKEND=local|onedrive (default local). MAIL_BACKEND=console|graph
# (default console, logs instead of sending). See docs/RUNBOOK.md for the
# GRAPH_* vars needed once STORAGE_BACKEND=onedrive / MAIL_BACKEND=graph.

# Signs the session JWT (backend/auth.py) -- unset falls back to an
# insecure local-dev-only default. MUST be set to a real random secret in
# any environment reachable by anyone other than you.
# SESSION_SECRET=

# Comma-separated emails to seed as the first Admin(s) -- required exactly
# once, the first time `backend.seed` runs against a roster with no Admin
# at all, since every other way onto the roster itself needs an existing
# Admin. Safe to leave set afterward: an email already on the roster is
# never touched on a later run. See docs/RUNBOOK.md's "First Admin" section.
# BOOTSTRAP_ADMIN_EMAILS=someone@algihaz.com
